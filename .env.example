# Copiez ce fichier vers .env puis renseignez vos valeurs.
# Ne committez jamais le fichier .env : il est ignore par git.

# --- Triage LLM ---------------------------------------------------------
# Option 1, cloud : cle API Anthropic. Laissez vide pour desactiver.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Option 2, offline : serveur Ollama local, par exemple http://host.docker.internal:11434
OLLAMA_HOST=
OLLAMA_MODEL=llama3.1

# Sans aucune des deux options, l'agent bascule sur le moteur heuristique
# deterministe : le pipeline reste fonctionnel et demontrable hors ligne.

# --- Confidentialite ----------------------------------------------------
# false : les adresses IP sont masquees avant l'envoi au LLM cloud.
SOCAI_SEND_IP=true

# --- Exploitation -------------------------------------------------------
SOCAI_API_PORT=8000
SOCAI_WEB_PORT=3000
SOCAI_LOG_LEVEL=INFO
SOCAI_POLL_INTERVAL=2
TZ=Europe/Paris
